#!/bin/sh
# Hook pre-commit del kit-app: bloquea commits con secretos (gitleaks).
# Cubre los commits MANUALES del usuario; las escrituras de Claude Code las cubre el hook
# PreToolUse de .claude/settings.json. Se activa con: git config core.hooksPath githooks
# (lo re-aplica `pnpm install` vía scripts/apply-hooks.mjs). Requiere gitleaks:
# brew install gitleaks / winget install Gitleaks.Gitleaks

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact
  status=$?
  if [ $status -eq 1 ]; then
    echo ""
    echo "SECRET DETECTADO: commit bloqueado."
    echo "Mueve la clave a .env.local (gitignored) o a las env vars de Vercel y reintenta."
    exit 1
  fi
elif [ "${KIT_SIN_GITLEAKS:-0}" = "1" ]; then
  echo "aviso: gitleaks no esta instalado — commit SIN scan de secretos (KIT_SIN_GITLEAKS=1, a sabiendas)."
else
  # Falla CERRADO (kit v1.32.1, B-8 planlang): un hook que avisa y deja pasar no es un gate.
  echo "gitleaks no esta instalado: commit BLOQUEADO. Instalalo (brew install gitleaks / winget install Gitleaks.Gitleaks)"
  echo "o, a sabiendas y por esta vez: KIT_SIN_GITLEAKS=1 git commit ..."
  exit 1
fi
exit 0
