{
  "name": "app-ds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/apply-hooks.mjs",
    "predev": "node scripts/copy-pyodide.mjs && node scripts/copy-brochure.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pyodide.mjs && node scripts/copy-brochure.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verificar:retiros": "node scripts/verificar-retiros.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.54",
    "@sentry/browser": "^10.75.3",
    "@sentry/nextjs": "^10.75.3",
    "ai": "^7.0.127",
    "next": "16.3.8",
    "pino": "^10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "pyodide": "314.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
